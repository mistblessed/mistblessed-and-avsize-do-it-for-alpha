# Generate local secrets with: python tools/bootstrap.py
ENCRYPTION_KEY=
REDIS_PASSWORD=
DEMO_API_KEY=
NO_RESTORE_API_KEY=
CONDITIONAL_API_KEY=
REDIS_URL=redis://redis:6379/0
NAMESPACE=alfa-pii-v1
STATE_TTL=1800
TOMBSTONE_TTL=86400
POLICIES_PATH=config/consumers.yaml
USE_NER=true
CPU_WORKERS=2
CPU_CAPACITY=16
CPU_TIMEOUT=8
REQUEST_CAPACITY=128
MAX_BODY_BYTES=8388608
MAX_TEXT_CHARS=2000000
# Hackathon public /process access (IPv4 and IPv6). Restrict after grading.
BENCHMARK_CIDRS=0.0.0.0/0,::/0
BENCHMARK_CONSUMER=benchmark
BIND_ADDRESS=127.0.0.1
PORT=8000
# OpenAI-compatible base URL, including /v1 when required.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30
# Optional PEM bundle for a private/corporate CA. Mount it into the container.
LLM_CA_BUNDLE=
ALLOW_HTTP_LLM=false
